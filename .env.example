# Optional. Without it the product works end to end: /api/parse falls back to
# the rule parser, /api/explain and /api/diff fall back to deterministic
# templates, and every date, count and status is computed locally as always.
#
# Server-only. It is read inside route handlers and never reaches the browser;
# there is deliberately no NEXT_PUBLIC_ variant of it.
ANTHROPIC_API_KEY=

# Optional. Absolute origin used for metadata and share URLs in production.
NEXT_PUBLIC_SITE_URL=
