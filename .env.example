# Optional. Without it the product works end to end: /api/parse falls back to
# the rule parser, /api/explain and /api/diff fall back to deterministic
# templates, every career-interview stage degrades per its own documented
# rule, and every date, count and status is computed locally as always.
#
# Server-only. It is read inside route handlers and never reaches the browser;
# there is deliberately no NEXT_PUBLIC_ variant of it. Get a key at
# https://aistudio.google.com/app/apikey.
GEMINI_API_KEY=
# Optional model override — defaults to gemini-2.0-flash.
GEMINI_MODEL=

# Optional. Absolute origin used for metadata and share URLs in production.
NEXT_PUBLIC_SITE_URL=

# Required for accounts (sign-in, the interview, parent invites). Without
# these the auth screens fail to load — see README.md "Аутентификация и
# данные" for how to create the project, apply supabase/migrations/*.sql and
# enable Google sign-in. Both are safe to expose to the browser: Supabase's
# row-level security policies are what actually protect the data, not this
# key being secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
